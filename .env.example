# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key — server-only, bypasses RLS.
# Copy from Supabase Dashboard → Project Settings → API → service_role key.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only — used to encrypt integration secrets at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
INTEGRATION_SECRET_KEY=

# KoboCollect webhook secret — REQUIRED for webhook endpoint security.
# Generate with:  openssl rand -hex 32
KOBO_WEBHOOK_SECRET=

# Sentry — error tracking (optional, app works without it)
# Create a project at https://sentry.io and paste the DSN here.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: enable verbose client logs in production builds.
# NEXT_PUBLIC_DEBUG=1

# ─── AgriTogo AI Integration ──────────────────────────────────────────────────

# ── DeepSeek (chat + voice responses) — REQUIS ────────────────────────────────
# Obtenez vos clés sur https://platform.deepseek.com/api_keys
# Ajoutez plusieurs clés pour la rotation automatique (évite les erreurs 429) :
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_KEY_1=sk-...
# DEEPSEEK_API_KEY_2=sk-...
# DEEPSEEK_API_KEY_3=sk-...

# Modèle DeepSeek. Le défaut du code (lib/utils/deepseek-client.ts) est
# « deepseek-v4-flash », et c'est le bon : AgriTogo a migré vers les modèles V4
# en juin 2026 (app/agents/router.py), les alias deepseek-chat et
# deepseek-reasoner ayant été retirés le 24 juillet 2026.
#
# ⚠️ Ne remettez PAS « deepseek-chat » ici : cet identifiant n'existe plus et
# fait échouer chaque appel en 400.
#
# Vérifiez l'identifiant exact sur https://platform.deepseek.com avant de le
# surcharger — les noms de modèles changent.
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Gemini (vision phytosanitaire + transcription vocale) — REQUIS si vision/voice ─
# DeepSeek ne supporte pas encore les images/audio. Gemini reste nécessaire pour :
#   - /api/ai/vision  → analyse de photos de cultures
#   - /api/ai/voice   → transcription de l'audio (étape 1), DeepSeek répond (étape 2)
# Obtenez des clés sur https://aistudio.google.com/app/apikey (tier gratuit suffisant)
GEMINI_API_KEY=AIza...
# GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...

# AgriTogo API — moteur multi-agent (AgentScope + DeepSeek) sur Railway.
# Si non configuré, fallback direct sur DeepSeek (niveau 3b).
AGRITOGO_API_URL=https://api.agritogo.tg

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Optional but strongly recommended in production to persist rate limits
# across serverless function instances (prevents brute-force on /verify).
# Create a Redis database at https://console.upstash.com and copy the values.
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Payments (Orange Money) ──────────────────────────────────────────────────
# Required to accept Orange Money payments via /api/payments/initiate.
ORANGE_MONEY_API_KEY=

# ─── Payments (CinetPay — Flooz / TMoney via a single aggregator) ─────────────
# Required to accept Flooz (Moov Africa) and TMoney (Togocom/Yas) payments via
# /api/payments/initiate. Get these from your CinetPay merchant dashboard:
# https://cinetpay.com — the aggregator covers both operators natively, so one
# integration serves the two networks that make up virtually all of Togo's
# mobile money market.
# Configure the notify_url in your CinetPay dashboard to:
#   ${NEXT_PUBLIC_APP_URL}/api/payments/cinetpay-callback
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret used to authenticate the /api/cron/notifications endpoint.
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# ─── App URL (used in payment redirect and link generation) ───────────────────
NEXT_PUBLIC_APP_URL=https://www.faitierehub.com

# Connexion par carte (code SMS) — sans CARD_AUTH_SECRET la fonction reste fermée
CARD_AUTH_SECRET=            # >= 32 caractères : openssl rand -hex 32
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# FedaPay — vente des comptes d'exploitation (webhook : /api/payments/fedapay/webhook)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox          # sandbox | live — seule source de vérité de l'environnement.
# sandbox : tout paiement direct part en « momo_test » (simulation FedaPay ;
#           numéros de test 64000001 / 66000001 acceptés, tout autre numéro échoue) ;
# live    : vrai opérateur (mtn_open, moov, sbin, moov_tg, togocel). Une clé sk_sandbox_… avec
# FEDAPAY_ENV=live (ou l'inverse) est refusée. Aucune clé FedaPay côté client.
# Facultatif : opérateurs à masquer, ids séparés par des virgules (vide = les 5 proposés).
# Ids : mtn_bj, moov_bj, celtiis_bj, moov_tg, togocel_tg. Effet après « Redeploy », sans code.
FEDAPAY_DISABLED_PROVIDERS=
NEXT_PUBLIC_APP_URL=https://www.faitierehub.com

# Confirmation par e-mail à l'inscription (FaîtiereHub ET AgriTogo). N'activer qu'après
# configuration du SMTP Supabase (Resend) et réception d'un e-mail de test.
REQUIRE_EMAIL_CONFIRMATION=false

# HarooLife pilot: enable only after database configuration and staging acceptance.
HAROOLIFE_ENABLED=false
NEXT_PUBLIC_HAROOLIFE_ENABLED=false
# Village 3D (PlayCanvas) : optionnel, ignoré si WebGL2 absent ou si l'utilisateur demande la sobriété
NEXT_PUBLIC_HAROOLIFE_3D=false

# HarooLife — dedicated always-on Railway relay (never Vercel/serverless WebSockets).
NEXT_PUBLIC_HAROOLIFE_REALTIME_URL=
HAROOLIFE_REALTIME_ORIGINS=https://faitierehub.com,https://www.faitierehub.com
# REQUIRED before more than one replica. No automatic fallback to isolated local presence.
HAROOLIFE_REALTIME_DISTRIBUTED=false
# Redis 7+ native protocol, server-only; use private network and TLS where available.
# This is NOT UPSTASH_REDIS_REST_URL. No Redis credential goes in NEXT_PUBLIC_*.
HAROOLIFE_REDIS_URL=
# Alternative for Redis Cluster: comma-separated seed redis(s):// URLs (same private cluster).
HAROOLIFE_REDIS_CLUSTER_URLS=
# All production replicas MUST share the same namespace. Separate staging from production.
HAROOLIFE_REALTIME_POOL=haroolife
HAROOLIFE_REALTIME_WORLD_CAPACITY=96
# Admission ceilings, NOT a declaration of tested capacity. Tune after staging load tests.
HAROOLIFE_REALTIME_MAX_CONNECTIONS=5000
HAROOLIFE_REALTIME_MAX_AUTHENTICATING=32
HAROOLIFE_REALTIME_MAX_DB_REQUESTS=64
# user: Auth server verifies; claims: verified cached JWKS (legacy HS256 still calls Auth).
# Keep user until asymmetric signing / revocation policy has been verified in staging.
HAROOLIFE_REALTIME_AUTH_MODE=user
